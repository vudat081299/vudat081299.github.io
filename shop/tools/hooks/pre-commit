#!/bin/sh
# Cổng lớp 2 cho shop/. Bộ điều phối gọi mọi */tools/hooks/pre-commit; hook này tự lọc —
# chỉ chạy khi commit có chạm shop/.
set -eu
ROOT=$(git rev-parse --show-toplevel)
CHANGED=$(git diff --cached --name-only --diff-filter=ACM)

echo "$CHANGED" | grep -q '^shop/' || exit 0
python3 "$ROOT/shop/tools/lint-shop.py"
