#!/bin/sh
# Cổng chất lượng cho cooking/ — chạy lúc commit. CHẶN.
# Cài: sh tools/install-hooks.sh  (bộ điều phối tự nhặt file này theo */tools/hooks/pre-commit)
#
# Chỉ chạy khi commit có chạm cooking/ — commit ở facts/, pages/… không bị ảnh hưởng.
# Thường chỉ soi ĐÚNG những trang và file data đang được commit, không soi cả thư mục.
# Ngoại lệ: commit sửa CHÍNH CỔNG (linter, hoặc hook này) thì soi lại mọi trang và mọi file
# data. Một phép kiểm vừa đổi có thể làm đỏ một trang không ai chạm, và lọc theo file đang
# commit thì không bao giờ thấy — cổng im lặng qua đúng lúc nó vừa bị sửa.
#
# Bỏ qua một lần (chỉ khi bạn BIẾT mình đang làm gì): git commit --no-verify

set -e
DIR="cooking"
ROOT=$(git rev-parse --show-toplevel)

CHANGED=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E "^$DIR/([^/]*\.html|data/[^/]*\.json)$" || true)
GATE=$(git diff --cached --name-only --diff-filter=ACMRD \
  | grep -E "^$DIR/tools/(lint-cooking\.py|hooks/pre-commit)$" || true)
[ -z "$CHANGED" ] && [ -z "$GATE" ] && exit 0

if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: không có python3 — bỏ qua cổng $DIR." >&2
  exit 0
fi

cd "$ROOT"
if [ -n "$GATE" ]; then
  echo "pre-commit: cổng $DIR vừa đổi — soi lại mọi trang và mọi file data…"
  TARGETS=""
else
  echo "pre-commit: chạy cổng $DIR…"
  TARGETS=$CHANGED
fi

# shellcheck disable=SC2086
if ! python3 "$DIR/tools/lint-cooking.py" $TARGETS; then
  cat >&2 <<'MSG'

──────────────────────────────────────────────────────────────────────
Commit bị chặn: cổng cooking không qua.

Mỗi trang trong cooking/ là một tài liệu tự chứa, và push main = deploy
thẳng lên GitHub Pages — không có build step nào bắt lỗi hộ.

  · id trùng      → id phải duy nhất; trùng thì anchor nhảy sai chỗ
  · anchor gãy    → href="#x" không có id nào tên x
  · asset thiếu   → src/href trỏ vào file không tồn tại
  · thẻ lệch      → div/section/table/ul/ol mở đóng không khớp
  · data/*.json   → id công thức trùng, cat/role lạ, region/dips lệch

Xem thêm:  python3 cooking/tools/lint-cooking.py -v
Bỏ qua có ý thức:  git commit --no-verify
──────────────────────────────────────────────────────────────────────
MSG
  exit 1
fi

echo "pre-commit: cổng $DIR qua."
