#!/bin/sh
# Hook commit duy nhất của repo: chạy cổng gốc, rồi tools/check.sh của mọi project có file trong commit.
set -u
cd "$(git rev-parse --show-toplevel)"
STAGED=$(git diff --cached --name-only)
sh tools/check.sh || exit 1
for c in $(git ls-files '*/tools/check.sh'); do
  dir=${c%/tools/check.sh}
  printf '%s\n' "$STAGED" | grep -q "^$dir/" || continue
  sh "$c" || { echo "pre-commit: $c không qua"; exit 1; }
done
